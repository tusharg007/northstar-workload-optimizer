# Copy this file to .env and replace every change-me value. The values below
# are disposable local-demo credentials, never production defaults.
NORTHSTAR_POSTGRES_ADMIN_USER=northstar_admin
NORTHSTAR_POSTGRES_ADMIN_PASSWORD=change-me-admin-password
NORTHSTAR_APP_DB_USER=northstar_app
NORTHSTAR_APP_DB_PASSWORD=change-me-app-password
N8N_DB_USER=northstar_n8n
N8N_DB_PASSWORD=change-me-n8n-db-password
METABASE_APP_DB_USER=northstar_metabase
METABASE_APP_DB_PASSWORD=change-me-metabase-db-password
NORTHSTAR_METABASE_DB_USER=northstar_metabase_ro
NORTHSTAR_METABASE_DB_PASSWORD=change-me-readonly-password

# Application-level encryption/admin secrets for the disposable demo stack.
N8N_ENCRYPTION_KEY=change-me-with-at-least-32-random-characters
METABASE_ENCRYPTION_SECRET_KEY=change-me-with-at-least-16-random-characters
METABASE_ADMIN_EMAIL=admin@northstar.local
METABASE_ADMIN_PASSWORD=change-me-metabase-admin-password

# Optional real email delivery through Resend. Leave unset for the in-memory sink.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
# NOTIFICATION_FROM_EMAIL=expenses@northstar.local
# NOTIFICATION_DIRECTORY={"Finance Director":"finance@example.com"}

# Optional advisory AI workflows. Leave the key unset to disable live generation.
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com
# For local Ollama, use: OPENAI_API_BASE=http://host.docker.internal:11434/v1

# Loopback-only host ports.
NORTHSTAR_POSTGRES_PORT=55432
NORTHSTAR_API_PORT=8000
N8N_PORT=5679
METABASE_PORT=3000

# Safe operational defaults.
NORTHSTAR_OUTBOX_RETRY_SECONDS=0,15,60,300
NORTHSTAR_OUTBOX_MAX_ATTEMPTS=4
NORTHSTAR_OUTBOX_LEASE_SECONDS=30
METABASE_HTTP_TIMEOUT_SECONDS=20
METABASE_READY_TIMEOUT_SECONDS=300

# Local/manual mode (Compose overrides these with service DNS).
NORTHSTAR_DATABASE_URL=sqlite:///data/northstar_runtime.db
NORTHSTAR_API_BASE_URL=http://127.0.0.1:8000
N8N_EXPENSE_WEBHOOK_URL=http://127.0.0.1:5679/webhook/northstar-expense
N8N_APPROVAL_WEBHOOK_URL=http://127.0.0.1:5679/webhook/northstar-approval
NORTHSTAR_MCP_HTTP_TIMEOUT_SECONDS=10
NORTHSTAR_MCP_LOG_LEVEL=INFO
NORTHSTAR_TEST_ORCHESTRATION_REGISTRATION_DELAY_MS=0
