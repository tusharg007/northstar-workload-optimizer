# Default local/test operational database (analytical northstar.db is separate)
NORTHSTAR_DATABASE_URL=sqlite:///data/northstar_runtime.db

# PostgreSQL example for Gate 1 verification/deployment:
# NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:northstar@localhost:5432/northstar

# Configurable operational approval SLA defaults (seconds):
# NORTHSTAR_APPROVAL_SLA_CRITICAL_SECONDS=14400
# NORTHSTAR_APPROVAL_SLA_HIGH_SECONDS=28800
# NORTHSTAR_APPROVAL_SLA_MEDIUM_SECONDS=86400
# NORTHSTAR_APPROVAL_SLA_LOW_SECONDS=172800

# Test-only race hook; leave at zero outside controlled verification:
NORTHSTAR_TEST_ORCHESTRATION_REGISTRATION_DELAY_MS=0
