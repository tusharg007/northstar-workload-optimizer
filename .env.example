# Default local/test operational database (analytical northstar.db is separate)
NORTHSTAR_DATABASE_URL=sqlite:///data/northstar_runtime.db

# PostgreSQL example for Gate 1 verification/deployment:
# NORTHSTAR_DATABASE_URL=postgresql+psycopg://northstar:northstar@localhost:5432/northstar

# Configurable operational approval SLA defaults (seconds):
# NORTHSTAR_APPROVAL_SLA_CRITICAL_SECONDS=14400
# NORTHSTAR_APPROVAL_SLA_HIGH_SECONDS=28800
# NORTHSTAR_APPROVAL_SLA_MEDIUM_SECONDS=86400
# NORTHSTAR_APPROVAL_SLA_LOW_SECONDS=172800

# Test-only race hook; leave at zero outside controlled verification:
NORTHSTAR_TEST_ORCHESTRATION_REGISTRATION_DELAY_MS=0

# Gate 3B delivery reliability defaults (immediate, 15s, 60s, 300s):
NORTHSTAR_OUTBOX_RETRY_SECONDS=0,15,60,300
NORTHSTAR_OUTBOX_MAX_ATTEMPTS=4
NORTHSTAR_OUTBOX_LEASE_SECONDS=30

# Gate 6 local/demo Metabase. Supply secrets in your shell; do not commit them.
NORTHSTAR_POSTGRES_ADMIN_USER=northstar
NORTHSTAR_POSTGRES_ADMIN_PASSWORD=<set-a-local-demo-password>
NORTHSTAR_POSTGRES_PORT=55432
NORTHSTAR_METABASE_DB_USER=northstar_metabase_ro
NORTHSTAR_METABASE_DB_PASSWORD=<set-a-distinct-read-only-password>
NORTHSTAR_METABASE_DB_HOST=postgres
NORTHSTAR_METABASE_DB_PORT=5432
NORTHSTAR_METABASE_DB_NAME=northstar
METABASE_URL=http://localhost:3000
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@northstar.local
METABASE_ADMIN_PASSWORD=<set-a-local-admin-password>
METABASE_HTTP_TIMEOUT_SECONDS=20
METABASE_READY_TIMEOUT_SECONDS=180
