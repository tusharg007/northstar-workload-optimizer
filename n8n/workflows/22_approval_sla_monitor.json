{
  "id": "northstarApprovalSLAMonitor",
  "name": "North Star | 22 Approval SLA Monitor",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "seconds", "secondsInterval": 10}]}},
      "id": "22000000-0000-4000-8000-000000000001",
      "name": "Approval SLA Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-720, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "22-api", "name": "api_base_url", "value": "http://127.0.0.1:8000", "type": "string"}]},
        "options": {}
      },
      "id": "22000000-0000-4000-8000-000000000002",
      "name": "Runtime Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base_url + '/api/internal/approval-tasks/sla/notifications/reserve' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({}) }}",
        "options": {"timeout": 5000, "response": {"response": {"fullResponse": true, "neverError": false, "responseFormat": "json"}}}
      },
      "id": "22000000-0000-4000-8000-000000000003",
      "name": "Reserve Due SLA Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 0]
    },
    {
      "parameters": {"fieldToSplitOut": "body.notifications", "include": "noOtherFields", "options": {"destinationFieldName": "notification"}},
      "id": "22000000-0000-4000-8000-000000000004",
      "name": "For Each Due Notification",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "22-notification", "name": "notification_id", "value": "={{ $json.notification.notification_id }}", "type": "string"},
          {"id": "22-outbox", "name": "outbox_event_id", "value": "={{ $json.notification.outbox_event_id }}", "type": "string"},
          {"id": "22-worker", "name": "worker_id", "value": "={{ 'n8n-immediate-sla-' + $execution.id }}", "type": "string"},
          {"id": "22-claimed", "name": "already_claimed", "value": false, "type": "boolean"},
          {"id": "22-task", "name": "task_id", "value": "={{ $json.notification.task_id }}", "type": "string"},
          {"id": "22-type", "name": "type", "value": "={{ $json.notification.type }}", "type": "string"},
          {"id": "22-level", "name": "escalation_level", "value": "={{ $json.notification.escalation_level }}", "type": "number"},
          {"id": "22-status", "name": "status", "value": "={{ $json.notification.status }}", "type": "string"},
          {"id": "22-target", "name": "target_role", "value": "={{ $json.notification.target_role }}", "type": "string"},
          {"id": "22-expense", "name": "expense_id", "value": "={{ $json.notification.expense_id }}", "type": "string"},
          {"id": "22-approver", "name": "approver_role", "value": "={{ $json.notification.approver_role }}", "type": "string"},
          {"id": "22-risk", "name": "risk_level", "value": "={{ $json.notification.risk_level }}", "type": "string"},
          {"id": "22-due", "name": "due_at", "value": "={{ $json.notification.due_at }}", "type": "string"},
          {"id": "22-summary", "name": "safe_summary", "value": "={{ $json.notification.safe_summary }}", "type": "object"}
        ]},
        "options": {}
      },
      "id": "22000000-0000-4000-8000-000000000005",
      "name": "Prepare SLA Notification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {"__rl": true, "value": "northstarApprovalNotificationService", "mode": "id"},
        "workflowInputs": {"mappingMode": "defineBelow", "value": {}, "matchingColumns": [], "schema": [], "attemptToConvertTypes": false, "convertFieldsToString": true},
        "mode": "each",
        "options": {"waitForSubWorkflow": true}
      },
      "id": "22000000-0000-4000-8000-000000000006",
      "name": "Send SLA Notification",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [480, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Approval SLA Schedule": {"main": [[{"node": "Runtime Configuration", "type": "main", "index": 0}]]},
    "Runtime Configuration": {"main": [[{"node": "Reserve Due SLA Notifications", "type": "main", "index": 0}]]},
    "Reserve Due SLA Notifications": {"main": [[{"node": "For Each Due Notification", "type": "main", "index": 0}]]},
    "For Each Due Notification": {"main": [[{"node": "Prepare SLA Notification", "type": "main", "index": 0}]]},
    "Prepare SLA Notification": {"main": [[{"node": "Send SLA Notification", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1", "timezone": "UTC", "errorWorkflow": "northstarGlobalErrorHandler"},
  "versionId": "22000000-0000-4000-8000-000000000099",
  "meta": {"templateCredsSetupCompleted": true},
  "tags": []
}
