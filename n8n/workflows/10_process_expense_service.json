{
  "id": "northstarProcessExpenseService",
  "name": "North Star | 10 Process Expense Service",
  "nodes": [
    {
      "parameters": {"inputSource": "passthrough"},
      "id": "c412fa19-10b2-4f6d-9cde-7aac13f97df2",
      "name": "Service Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "process-api-base", "name": "api_base_url", "value": "http://127.0.0.1:8000", "type": "string"}
        ]},
        "includeOtherFields": true,
        "options": {}
      },
      "id": "9498168e-4ff2-42ac-80e2-d314093001d2",
      "name": "Runtime Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_base_url + '/api/expenses/process' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [
          {"name": "Content-Type", "value": "application/json"},
          {"name": "X-Correlation-ID", "value": "={{ $json.correlation_id }}"},
          {"name": "Idempotency-Key", "value": "={{ $json.idempotency_key }}"}
        ]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 5000,
          "response": {"response": {"fullResponse": true, "neverError": true, "responseFormat": "json"}}
        }
      },
      "id": "e75b78b1-c4f2-47a6-98f4-c9d735fa2b38",
      "name": "Call FastAPI Process Expense",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [{"id": "process-review-required", "leftValue": "={{ String(Number($json.statusCode) === 200 && ['PENDING_APPROVAL', 'ESCALATED'].includes($json.body?.status)) }}", "rightValue": "true", "operator": {"type": "string", "operation": "equals"}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "Approval Orchestration Required",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Runtime Configuration').item.json.api_base_url + '/api/internal/approval-tasks/by-expense/' + encodeURIComponent($('Call FastAPI Process Expense').item.json.body.expense_id) + '/orchestration/claim' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({}) }}",
        "options": {"timeout": 5000, "response": {"response": {"fullResponse": true, "neverError": true, "responseFormat": "json"}}}
      },
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Claim Approval Orchestration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, -120]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "process-ok", "name": "ok", "value": "={{ Number($('Call FastAPI Process Expense').item.json.statusCode) === 200 }}", "type": "boolean"},
          {"id": "process-status", "name": "status_code", "value": "={{ [200, 409, 422].includes(Number($('Call FastAPI Process Expense').item.json.statusCode)) ? Number($('Call FastAPI Process Expense').item.json.statusCode) : 502 }}", "type": "number"},
          {"id": "process-correlation", "name": "correlation_id", "value": "={{ $('Service Input').item.json.correlation_id }}", "type": "string"},
          {"id": "process-data", "name": "data", "value": "={{ [200, 409, 422].includes(Number($('Call FastAPI Process Expense').item.json.statusCode)) && $('Call FastAPI Process Expense').item.json.body ? $('Call FastAPI Process Expense').item.json.body : null }}", "type": "object"},
          {"id": "process-error", "name": "error", "value": "={{ [200, 409, 422].includes(Number($('Call FastAPI Process Expense').item.json.statusCode)) ? null : ({ message: 'Upstream service unavailable' }) }}", "type": "object"},
          {"id": "process-launch", "name": "launch_required", "value": "={{ $json.body?.launch_required === true }}", "type": "boolean"},
          {"id": "process-task", "name": "task_id", "value": "={{ $json.body?.task_id || '' }}", "type": "string"},
          {"id": "process-expense", "name": "expense_id", "value": "={{ $('Call FastAPI Process Expense').item.json.body?.expense_id || '' }}", "type": "string"}
        ]},
        "options": {}
      },
      "id": "b8715201-d5ad-4fa1-856b-fd144dc2a1a9",
      "name": "Return Service Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Service Input": {"main": [[{"node": "Runtime Configuration", "type": "main", "index": 0}]]},
    "Runtime Configuration": {"main": [[{"node": "Call FastAPI Process Expense", "type": "main", "index": 0}]]},
    "Call FastAPI Process Expense": {"main": [[{"node": "Approval Orchestration Required", "type": "main", "index": 0}]]},
    "Approval Orchestration Required": {"main": [[{"node": "Claim Approval Orchestration", "type": "main", "index": 0}], [{"node": "Return Service Envelope", "type": "main", "index": 0}]]},
    "Claim Approval Orchestration": {"main": [[{"node": "Return Service Envelope", "type": "main", "index": 0}]]}
  },
