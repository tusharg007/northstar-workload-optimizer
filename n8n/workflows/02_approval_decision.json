      "typeVersion": 3.4,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "approval-context-id", "name": "expense_id", "value": "={{ $json.expense_id }}", "type": "string"},
            {"id": "approval-context-payload", "name": "payload", "value": "={{ $json.payload }}", "type": "object"},
            {"id": "approval-context-correlation", "name": "correlation_id", "value": "={{ $json.incoming_correlation_id || ('northstar-n8n-' + $execution.id) }}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "32f976d0-1b75-4ff1-b17c-c827eb8247af",
      "name": "Build Orchestration Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {"__rl": true, "value": "northstarRecordDecisionService", "mode": "id"},
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {"waitForSubWorkflow": true}
      },
      "id": "70ee372f-b2f7-4c1b-aa58-0586040f50fa",
      "name": "Record Decision Service",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [0, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "approval-preserve-status", "name": "status_code", "value": "={{ $json.status_code }}", "type": "number"},
          {"id": "approval-preserve-data", "name": "data", "value": "={{ $json.data }}", "type": "object"},
          {"id": "approval-preserve-error", "name": "error", "value": "={{ $json.error }}", "type": "object"},
          {"id": "approval-preserve-resume", "name": "resume_url", "value": "={{ $json.resume_url || '' }}", "type": "string"}
        ]},
        "options": {}
      },
      "id": "02000000-0000-4000-8000-000000000001",
      "name": "Preserve Persisted Decision Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [{"id": "approval-resume", "leftValue": "={{ String(Number($json.status_code) === 200 && $json.resume_url.length > 0) }}", "rightValue": "true", "operator": {"type": "string", "operation": "equals"}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "02000000-0000-4000-8000-000000000002",
      "name": "Active Wait Exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Preserve Persisted Decision Result').item.json.resume_url }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ expense_id: $('Build Orchestration Context').item.json.expense_id, persisted_status: $('Preserve Persisted Decision Result').item.json.data.status }) }}",
        "options": {"timeout": 5000, "response": {"response": {"fullResponse": true, "neverError": true, "responseFormat": "json"}}}
      },
      "id": "02000000-0000-4000-8000-000000000003",
      "name": "Resume Waiting Approval Orchestrator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -120],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "approval-response-body", "name": "response_body", "value": "={{ [200, 409, 422].includes(Number($('Preserve Persisted Decision Result').item.json.status_code)) && $('Preserve Persisted Decision Result').item.json.data ? $('Preserve Persisted Decision Result').item.json.data : ({ error: 'Upstream service unavailable', correlation_id: $('Build Orchestration Context').item.json.correlation_id }) }}", "type": "object"},
            {"id": "approval-response-status", "name": "response_status", "value": "={{ [200, 409, 422].includes(Number($('Preserve Persisted Decision Result').item.json.status_code)) ? Number($('Preserve Persisted Decision Result').item.json.status_code) : 502 }}", "type": "number"},
            {"id": "approval-response-correlation", "name": "correlation_id", "value": "={{ $('Build Orchestration Context').item.json.correlation_id }}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "8b9e517c-e82c-4675-a962-735b3ef1d43b",
      "name": "Map API Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.response_body }}",
        "options": {
          "responseCode": "={{ $json.response_status }}",
          "responseHeaders": {
            "entries": [
              {"name": "Content-Type", "value": "application/json"},
              {"name": "X-Correlation-ID", "value": "={{ $json.correlation_id }}"}
            ]
          }
        }
      },
      "id": "7e61b1f5-8bfe-458b-9e3c-66e4759ee47a",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1200, 0]
    }
