              "type": "string"
            },
            {
              "id": "approval-payload",
              "name": "payload",
              "value": "={{ ({ decision: $json.body?.decision, approver: $json.body?.approver, comment: $json.body?.comment || '' }) }}",
              "type": "object"
            },
            {
              "id": "approval-correlation",
              "name": "incoming_correlation_id",
              "value": "={{ $json.headers?.['x-correlation-id'] || '' }}",
