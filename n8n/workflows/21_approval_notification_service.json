{
  "id": "northstarApprovalNotificationService",
  "name": "North Star | 21 Approval Notification Service",
  "nodes": [
    {
      "parameters": {"inputSource": "passthrough"},
      "id": "21000000-0000-4000-8000-000000000001",
      "name": "Notification Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "21-api", "name": "api_base_url", "value": "http://127.0.0.1:8000", "type": "string"},
          {"id": "21-sink", "name": "notification_sink_url", "value": "http://127.0.0.1:9010/notifications", "type": "string"}
        ]},
        "includeOtherFields": true,
        "options": {}
      },
      "id": "21000000-0000-4000-8000-000000000002",
      "name": "Runtime Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-360, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2},
          "conditions": [{"id": "21-pending", "leftValue": "={{ $json.status }}", "rightValue": "PENDING", "operator": {"type": "string", "operation": "equals"}}],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "21000000-0000-4000-8000-000000000003",
      "name": "Notification Is Pending",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-120, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Runtime Configuration').item.json.notification_sink_url }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $('Notification Input').item.json }}",
        "options": {"timeout": 5000, "response": {"response": {"fullResponse": true, "neverError": false, "responseFormat": "json"}}}
      },
      "id": "21000000-0000-4000-8000-000000000004",
      "name": "Send to Notification Sink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Runtime Configuration').item.json.api_base_url + '/api/internal/approval-notifications/' + encodeURIComponent($('Notification Input').item.json.notification_id) + '/sent' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ provider_message_id: $json.body.provider_message_id }) }}",
        "options": {"timeout": 5000, "response": {"response": {"fullResponse": true, "neverError": false, "responseFormat": "json"}}}
      },
      "id": "21000000-0000-4000-8000-000000000005",
      "name": "Persist Notification Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, -120]
    },
    {
      "parameters": {"assignments": {"assignments": [{"id": "21-result", "name": "notification_result", "value": "={{ $json.body || $('Notification Input').item.json }}", "type": "object"}]}, "options": {}},
      "id": "21000000-0000-4000-8000-000000000006",
      "name": "Return Notification Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Notification Input": {"main": [[{"node": "Runtime Configuration", "type": "main", "index": 0}]]},
    "Runtime Configuration": {"main": [[{"node": "Notification Is Pending", "type": "main", "index": 0}]]},
    "Notification Is Pending": {"main": [[{"node": "Send to Notification Sink", "type": "main", "index": 0}], [{"node": "Return Notification Result", "type": "main", "index": 0}]]},
    "Send to Notification Sink": {"main": [[{"node": "Persist Notification Sent", "type": "main", "index": 0}]]},
    "Persist Notification Sent": {"main": [[{"node": "Return Notification Result", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "21000000-0000-4000-8000-000000000099",
  "meta": {"templateCredsSetupCompleted": true},
  "tags": []
}
