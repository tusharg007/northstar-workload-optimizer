{
  "id": "northstarExecutiveBriefingAgent",
  "name": "North Star | 25 Executive Briefing Agent",
  "nodes": [
    {
      "parameters": {"inputSource": "passthrough"},
      "id": "25000000-0000-4000-8000-000000000001",
      "name": "Briefing Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "25-expense", "name": "expense_id", "value": "={{ $json.expense_id || $json.safe_summary?.expense_id || '' }}", "type": "string"},
          {"id": "25-risk", "name": "risk_level", "value": "={{ $json.risk_level || $json.safe_summary?.risk_level || 'UNKNOWN' }}", "type": "string"},
          {"id": "25-correlation", "name": "correlation_id", "value": "={{ $json.correlation_id || ('northstar-briefing-' + $execution.id) }}", "type": "string"},
          {"id": "25-prompt", "name": "prompt", "value": "={{ 'Write a 2-3 sentence executive summary for a compliance notification. The expense details are: Employee: ' + ($json.employee_name || $json.safe_summary?.employee_name || 'Not provided') + ', Amount: $' + ($json.amount ?? $json.safe_summary?.amount ?? 'Not provided') + ', Category: ' + ($json.category || $json.safe_summary?.category || 'Not provided') + ', Risk Level: ' + ($json.risk_level || $json.safe_summary?.risk_level || 'UNKNOWN') + ', Anomaly Flags: ' + JSON.stringify($json.anomaly_flags || $json.safe_summary?.anomaly_flags || []) + ', Routing: ' + ($json.routing_reason || ('Routed to ' + ($json.target_role || $json.safe_summary?.approver_role || 'human review'))) + '. Explain factually why this expense requires human review. Do NOT recommend approval or rejection. Do NOT assign risk scores.' }}", "type": "string"}
        ]},
        "options": {}
      },
      "id": "25000000-0000-4000-8000-000000000002",
      "name": "Build Briefing Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.OPENAI_API_BASE || 'https://api.openai.com').replace(/\\\/$/, '').replace(/\\\/v1$/, '') + '/v1/chat/completions' }}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [
          {"name": "Authorization", "value": "={{ 'Bearer ' + $env.OPENAI_API_KEY }}"},
          {"name": "Content-Type", "value": "application/json"},
          {"name": "X-Correlation-ID", "value": "={{ $json.correlation_id }}"}
        ]},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ model: 'gpt-4o-mini', messages: [{ role: 'system', content: 'You are a compliance notification writer.' }, { role: 'user', content: $json.prompt }], max_tokens: 200, temperature: 0.3 }) }}",
        "options": {"timeout": 5000, "response": {"response": {"fullResponse": true, "neverError": false, "responseFormat": "json"}}}
      },
      "id": "25000000-0000-4000-8000-000000000003",
      "name": "Generate Briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "25-summary", "name": "executive_summary", "value": "={{ $json.body?.choices?.[0]?.message?.content || '' }}", "type": "string"}
        ]},
        "options": {}
      },
      "id": "25000000-0000-4000-8000-000000000004",
      "name": "Extract Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "assignments": {"assignments": [
          {"id": "25-return", "name": "executive_summary", "value": "={{ $json.executive_summary }}", "type": "string"}
        ]},
        "options": {}
      },
      "id": "25000000-0000-4000-8000-000000000005",
      "name": "Return Briefing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 0]
    }
  ],
  "pinData": {},
  "connections": {
    "Briefing Input": {"main": [[{"node": "Build Briefing Prompt", "type": "main", "index": 0}]]},
    "Build Briefing Prompt": {"main": [[{"node": "Generate Briefing", "type": "main", "index": 0}]]},
    "Generate Briefing": {"main": [[{"node": "Extract Summary", "type": "main", "index": 0}]]},
    "Extract Summary": {"main": [[{"node": "Return Briefing", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1", "errorWorkflow": "northstarGlobalErrorHandler"},
  "versionId": "25000000-0000-4000-8000-000000000099",
  "meta": {"templateCredsSetupCompleted": true},
  "tags": []
}
